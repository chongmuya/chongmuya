{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NEXT_PUBLIC_API_ORIGIN",
        "NEXT_PUBLIC_NAVER_MAP_CLIENT_ID",
        "NODE_ENV"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "@chongmuya/web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NEXT_PUBLIC_API_ORIGIN", "NEXT_PUBLIC_NAVER_MAP_CLIENT_ID"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "@chongmuya/api#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "cache": false
    },
    "typecheck": {
      "cache": false,
      "passThroughEnv": ["NEXT_PUBLIC_API_ORIGIN"]
    },
    "test": {
      "cache": false
    },
    "@chongmuya/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_PORT",
        "DATABASE_URL",
        "API_DOCS_ENABLED",
        "NODE_ENV",
        "AUTH_SECRET",
        "WEB_ORIGIN",
        "OCTOMO_API_KEY",
        "RESEND_API_KEY",
        "RESEND_FROM",
        "RESEND_REPLY_TO",
        "KAKAO_ADMIN_KEY",
        "KAKAO_CLIENT_ID",
        "KAKAO_CLIENT_SECRET",
        "KAKAO_REDIRECT_URI",
        "EMAIL_VERIFICATION_SECRET",
        "TRUST_PROXY_HOPS",
        "TRUSTED_PROXY_CIDRS",
        "MESSAGE_PROVIDER",
        "SMS_SEND_ENABLED",
        "SOLAPI_API_KEY",
        "SOLAPI_API_SECRET",
        "SOLAPI_SENDER_NUMBER",
        "SOLAPI_WEBHOOK_SECRET",
        "GEOCODING_PROVIDER",
        "NAVER_MAP_CLIENT_ID",
        "NAVER_MAP_CLIENT_SECRET",
        "OWNER_SUPPORT_EMAIL",
        "MERCHANT_REPLY_TOKEN_ENCRYPTION_KEY",
        "PROVIDER_TIMEOUT_MS",
        "MERCHANT_REPLY_TTL_HOURS",
        "RESERVATION_MANAGEMENT_TTL_HOURS",
        "FILES_S3_BUCKET",
        "FILES_S3_REGION",
        "FILES_MAX_COUNT",
        "FILES_MAX_BYTES",
        "REMINDERS_ENABLED",
        "RESEND_DEBUG"
      ]
    }
  }
}
