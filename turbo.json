{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["NEXT_PUBLIC_API_ORIGIN", "NODE_ENV"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "@chongmuya/web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NEXT_PUBLIC_API_ORIGIN"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "@chongmuya/api#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "cache": false
    },
    "typecheck": {
      "cache": false,
      "passThroughEnv": ["NEXT_PUBLIC_API_ORIGIN"]
    },
    "test": {
      "cache": false
    },
    "@chongmuya/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_PORT",
        "DATABASE_URL",
        "API_DOCS_ENABLED",
        "NODE_ENV",
        "AUTH_SECRET",
        "WEB_ORIGIN",
        "OCTOMO_API_KEY",
        "SIGNUP_TERMS_JSON",
        "RESEND_API_KEY",
        "RESEND_FROM",
        "RESEND_REPLY_TO",
        "KAKAO_CLIENT_ID",
        "KAKAO_CLIENT_SECRET",
        "KAKAO_REDIRECT_URI",
        "EMAIL_VERIFICATION_SECRET"
      ]
    }
  }
}
