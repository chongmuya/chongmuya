# Public Nest API origin, embedded in the browser bundle at build time.
# Use localhost for both web and API in development. Rebuild after changes.
# Required for production builds/start; HTTPS except explicit local testing.
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

# Optional NAVER Maps Dynamic Map Client ID (ncpKeyId). Register the web origin in NAVER Cloud.
# Without this public ID, restaurant addresses and the list remain available. Rebuild after changes.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
