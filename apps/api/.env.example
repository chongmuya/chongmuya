NODE_ENV=development
API_PORT=3001
API_DOCS_ENABLED=true
# Local Docker Compose development database only. Never use these credentials in production.
DATABASE_URL=postgresql://chongmuya:chongmuya_local@127.0.0.1:15432/chongmuya

# Generate with openssl rand -hex 32 (at least 32 characters); never commit real values.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Exact frontend origin for CORS and CSRF. Production web/API use same-site HTTPS hosts.
WEB_ORIGIN=http://localhost:3000

# Server only. Missing key keeps login available but real phone verification returns 503.
OCTOMO_API_KEY=your-octomo-api-key
# Optional: replace all four editable draft terms with reviewed HTTPS documents.
# SIGNUP_TERMS_JSON=[{"id":"serviceTerms","version":"2026-11-16","url":"https://example.com/terms"},{"id":"privacyCollection","version":"2026-11-16","url":"https://example.com/privacy-consent"},{"id":"privacyPolicy","version":"2026-11-16","url":"https://example.com/privacy"},{"id":"marketing","version":"2026-11-16","url":"https://example.com/marketing"}]

# Optional Kakao OIDC: configure all three together, server only.
# Register this public Nest callback in Kakao; completion redirects to WEB_ORIGIN.
# openid + account_email requires OIDC and the app's email permission/consent configuration.
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:3001/api/v1/auth/kakao/callback

# Signup email verification: configure all three together. Server only.
RESEND_API_KEY=re_replace-with-your-key
RESEND_FROM="총무야 <account@auth.chongmuya.com>"
# Optional override for the default reply address; does not change the sender.
RESEND_REPLY_TO=support@chongmuya.com
EMAIL_VERIFICATION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
