NODE_ENV=development
API_PORT=3001
API_DOCS_ENABLED=true
# Local Docker Compose development database only. Never use these credentials in production.
DATABASE_URL=postgresql://chongmuya:chongmuya_local@127.0.0.1:15432/chongmuya

# Generate with openssl rand -hex 32 (at least 32 characters); never commit real values.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
WEB_ORIGIN=http://localhost:3000

# Server only. Missing key keeps login available but real phone verification returns 503.
OCTOMO_API_KEY=your-octomo-api-key
# Optional: replace all four editable draft terms with reviewed HTTPS documents.
# SIGNUP_TERMS_JSON=[{"id":"serviceTerms","version":"2026-11-16","url":"https://example.com/terms"},{"id":"privacyCollection","version":"2026-11-16","url":"https://example.com/privacy-consent"},{"id":"privacyPolicy","version":"2026-11-16","url":"https://example.com/privacy"},{"id":"marketing","version":"2026-11-16","url":"https://example.com/marketing"}]
