# 서버·DB
NODE_ENV=development
API_PORT=3001
API_DOCS_ENABLED=true
DATABASE_URL=postgresql://chongmuya:chongmuya_local@127.0.0.1:15432/chongmuya
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0

# 로그인 인증
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# 휴대폰 인증 · Octomo
OCTOMO_API_KEY=your-octomo-api-key

# 카카오 로그인
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:3001/api/v1/auth/kakao/callback

# 이메일 인증 · Resend
RESEND_API_KEY=re_replace-with-your-key
RESEND_FROM="총무야 <account@auth.chongmuya.com>"
RESEND_REPLY_TO=support@chongmuya.com
EMAIL_VERIFICATION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters

# 문의 문자 · SOLAPI
MESSAGE_PROVIDER=fake
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER_NUMBER=
# SOLAPI_WEBHOOK_SECRET=

# 주소 검색 · NAVER
GEOCODING_PROVIDER=fake
# NAVER_MAP_CLIENT_ID=
# NAVER_MAP_CLIENT_SECRET=

# 사장님 문의 링크·운영
# OWNER_SUPPORT_EMAIL=
# MERCHANT_REPLY_TOKEN_ENCRYPTION_KEY=
MERCHANT_REPLY_TTL_HOURS=168
RESERVATION_MANAGEMENT_TTL_HOURS=168

# 외부 API 요청 제한 시간
PROVIDER_TIMEOUT_MS=5000

# 로컬 db:seed의 신규 계정 기본 비밀번호는 Demo1234!입니다.
# 선택: DEMO_SEED_PASSWORD로 변경 가능 (ASCII 8~16자, 공백 제외). 기존 계정은 유지합니다.

# PR3 private attachment storage. No bucket is created by the application.
# AWS credentials come from the standard SDK credential chain / instance role.
# Leave bucket unset to reject storage operations explicitly (503).
# FILES_S3_BUCKET=private-bucket-name
FILES_S3_REGION=ap-northeast-2
# Deployment limits, not an unlimited-storage product promise.
FILES_MAX_COUNT=100
FILES_MAX_BYTES=524288000

# Server-side inbox reminders: daily 09:00 Asia/Seoul. No SMS.
# Default off. Enable only after the explicit CalendarInbox migration.
# Same-day startup recovery after 09:00; bounded retries only on failure.
REMINDERS_ENABLED=false
