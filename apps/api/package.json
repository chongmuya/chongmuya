{
  "name": "@chongmuya/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "account:withdrawals": "node scripts/account-withdrawals.mjs",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "db:migration:generate": "pnpm build && typeorm migration:generate -d dist/database/data-source.js",
    "db:migration:show": "typeorm migration:show -d dist/database/data-source.js",
    "db:migration:run": "typeorm migration:run -d dist/database/data-source.js",
    "test:compile": "node scripts/compile-tests.mjs",
    "test": "pnpm test:compile && node --test dist-test/test/*.test.js",
    "test:integration": "pnpm test:compile && node --test --test-concurrency=1 dist-test/test/integration/*.test.js",
    "reservation:operations": "node scripts/reservation-operations.mjs",
    "merchant:operations": "node scripts/merchant-operations.mjs",
    "db:demo:links": "node dist/database/seeds/run-demo.js links",
    "reservation:completion": "node scripts/reservation-completion.mjs",
    "db:seed": "node dist/database/seeds/run-demo.js seed",
    "db:reset": "node dist/database/seeds/run-demo.js reset",
    "data:restaurants": "node scripts/restaurant-data.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "12.0.4",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/typeorm": "12.0.2",
    "cfb": "^1.2.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "file-type": "^22.3.0",
    "openid-client": "6.9.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "resend": "^6.38.1",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
